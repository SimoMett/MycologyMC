{
  "schemaVersion": 1,
  "id": "mycologymod",
  "version": "${version}",
  "name": "Mycology",
  "description": "This is an example description! Tell everyone what your mod is about!",
  "authors": [
    "SimoMett"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/FabricMC/fabric-example-mod"
  },
  "license": "ARR",
  "icon": "assets/mycologymod/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.simomett.mycologymod.MycologyMod"
    ],
    "client": [
      "com.simomett.mycologymod.client.MycologyModClient"
    ],
    "fabric-datagen": [
      "com.simomett.mycologymod.client.datagen.DataGenerator"
    ]
  },
  "mixins": [
    "mycologymod.fabric.mixins.json",
    {
      "config": "mycologymod.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.1.2",
    "java": ">=25",
    "fabric-api": "*"
